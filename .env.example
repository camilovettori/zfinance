# HomeCoin stays local by default. Do not add service-role or database credentials here.
VITE_SYNC_ENABLED=false

# Browser-safe Supabase configuration. Copy to .env.local; never commit real values.
# Both values are required when the flag is true. Do not use service_role here.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Optional canonical web/PWA URL used when sharing invitation links.
VITE_PUBLIC_APP_URL=
