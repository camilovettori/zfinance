{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "HomeCoin main window capabilities, including local SQLite storage and app-managed backup exports in Documents/HomeCoin/Backups.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$DOCUMENT/HomeCoin/Backups" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$DOCUMENT/HomeCoin/Backups/*" }]
    }
  ]
}
